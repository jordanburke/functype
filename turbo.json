{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "globalPassThroughEnv": [
    "TS_BUILDS_TELEMETRY",
    "TS_BUILDS_TELEMETRY_URL",
    "TS_BUILDS_TELEMETRY_DEBUG",
    "TS_BUILDS_TELEMETRY_TRACE",
    "DO_NOT_TRACK"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "lib/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "CI"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "eslint-plugin-functype#build",
        "eslint-config-functype#build"
      ],
      "outputs": []
    },
    "lint:check": {
      "dependsOn": [
        "eslint-plugin-functype#build",
        "eslint-config-functype#build"
      ],
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "compile": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "validate": {
      "env": [
        "CI"
      ],
      "dependsOn": [
        "^build",
        "eslint-plugin-functype#build",
        "eslint-config-functype#build"
      ],
      "outputs": [
        "dist/**",
        "lib/**"
      ]
    },
    "site#validate": {
      "env": [
        "CI"
      ],
      "dependsOn": [
        "^build",
        "eslint-plugin-functype#build",
        "eslint-config-functype#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/functype/src/**",
        "$TURBO_ROOT$/packages/functype/test/docs/snippet-typecheck.ts",
        "$TURBO_ROOT$/packages/functype/tsconfig.json",
        "$TURBO_ROOT$/packages/functype/package.json",
        "$TURBO_ROOT$/packages/functype-os/src/**",
        "$TURBO_ROOT$/packages/functype-os/package.json",
        "$TURBO_ROOT$/packages/functype-log/src/**",
        "$TURBO_ROOT$/packages/functype-log/package.json",
        "$TURBO_ROOT$/packages/functype-kysely/src/**",
        "$TURBO_ROOT$/packages/functype-kysely/package.json",
        "$TURBO_ROOT$/packages/*/README.md",
        "$TURBO_ROOT$/packages/eslint-plugin-functype/README.md"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
