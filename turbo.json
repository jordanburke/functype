{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "globalPassThroughEnv": [
    "TS_BUILDS_TELEMETRY",
    "TS_BUILDS_TELEMETRY_URL",
    "TS_BUILDS_TELEMETRY_DEBUG",
    "TS_BUILDS_TELEMETRY_TRACE",
    "DO_NOT_TRACK"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "lib/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "eslint-plugin-functype#build",
        "eslint-config-functype#build"
      ],
      "outputs": []
    },
    "lint:check": {
      "dependsOn": [
        "eslint-plugin-functype#build",
        "eslint-config-functype#build"
      ],
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "compile": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "validate": {
      "dependsOn": [
        "^build",
        "eslint-plugin-functype#build",
        "eslint-config-functype#build"
      ],
      "outputs": [
        "dist/**",
        "lib/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
