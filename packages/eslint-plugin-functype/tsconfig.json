{
  "extends": "ts-builds/tsconfig",
  "compilerOptions": {
    // ".." rather than ".": tests/configs.test.ts checks the presets against eslint-config-functype's src.
    "rootDir": "..",
    "outDir": "lib",
    "types": ["node"]
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist", "lib"]
}
