{
  "name": "functype-monorepo",
  "private": true,
  "type": "module",
  "description": "Monorepo for the functype family of TypeScript FP libraries",
  "author": "jordan.burke@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordanburke/functype.git"
  },
  "homepage": "https://functype.org/",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "validate": "pnpm sync:eslint-mirror:test && turbo run validate",
    "compile": "turbo run compile",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "clean": "pnpm -r clean && rm -rf .turbo",
    "sync:eslint-mirror": "tsx scripts/sync-eslint-mirror.ts",
    "sync:eslint-mirror:check": "tsx scripts/sync-eslint-mirror.ts --check",
    "sync:eslint-mirror:test": "tsx scripts/sync-eslint-mirror.ts --test",
    "sync:plugin-lock": "tsx scripts/sync-plugin-lock.ts",
    "sync:plugin-lock:check": "tsx scripts/sync-plugin-lock.ts --check",
    "check-publish-safety": "tsx scripts/check-publish-safety.ts",
    "release": "tsx scripts/release.ts",
    "verify-published": "tsx scripts/verify-published.ts"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "vitest": "^5.1.0"
  }
}
