---
const path = Astro.url.pathname;
const links = [
  {
    href: "/option/",
    label: "Docs",
    match: (p: string) =>
      p !== "/" && !p.startsWith("/upgrading-to-2") && !p.startsWith("/mcp-server") && !p.startsWith("/performance"),
  },
  { href: "/#types", label: "Types", match: () => false },
  { href: "/agents/", label: "Agents", match: (p: string) => p.startsWith("/agents") || p.startsWith("/mcp-server") },
  { href: "/performance/", label: "Performance", match: (p: string) => p.startsWith("/performance") },
  { href: "/upgrading-to-2/", label: "Upgrade to 2.0", match: (p: string) => p.startsWith("/upgrading-to-2") },
];
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="logo" href="/" aria-label="functype home"
      ><svg class="mark" viewBox="-0.2 4 22.7 16" aria-hidden="true" focusable="false"><path d="M4.727 8.582L7.090 8.582L7.090 10.574L4.727 10.574L4.727 19.500L2.197 19.500L2.197 10.574L0.195 10.574L0.195 8.582L2.197 8.582L2.197 7.537Q2.197 6.443 2.651 5.721Q3.105 4.998 3.882 4.632Q4.658 4.266 5.586 4.266L5.586 4.266Q6.260 4.266 6.777 4.373Q7.295 4.480 7.539 4.568L7.539 4.568L7.021 6.541Q6.855 6.492 6.616 6.438Q6.377 6.385 6.055 6.385L6.055 6.385Q5.342 6.385 5.034 6.736Q4.727 7.088 4.727 7.732L4.727 7.732L4.727 8.582Z" fill="currentColor"/><circle class="dot-value" cx="11.45" cy="10.532" r="1.95"/><circle class="dot-type" cx="11.45" cy="17.55" r="1.95"/><path transform="translate(15.65 0)" d="M4.287 8.582L6.396 8.582L6.396 10.574L4.287 10.574L4.287 16.424Q4.287 17.020 4.541 17.298Q4.795 17.576 5.371 17.576L5.371 17.576Q5.547 17.576 5.835 17.532Q6.123 17.488 6.299 17.449L6.299 17.449L6.699 19.412Q6.279 19.539 5.840 19.593Q5.400 19.646 5 19.646L5 19.646Q3.428 19.646 2.588 18.865Q1.748 18.084 1.748 16.639L1.748 16.639L1.748 10.574L0.195 10.574L0.195 8.582L1.748 8.582L1.748 5.984L4.287 5.984L4.287 8.582Z" fill="currentColor"/></svg><span>functype</span></a
    >
    <ul>
      {
        links.map((l) => (
          <li class={l.label === "Docs" ? undefined : "hide-sm"}>
            <a href={l.href} aria-current={l.match(path) ? "page" : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
      <li><a href="https://github.com/jordanburke/functype">GitHub</a></li>
      <li>
        <button class="theme" type="button" id="theme-toggle" aria-label="Theme: Auto. Switch to Dark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
            ><circle cx="12" cy="12" r="8"></circle><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path></svg
          >
          <span id="theme-label">Auto</span>
        </button>
      </li>
    </ul>
  </div>
</header>

<script>
  // The theme follows the system until you pick one: Auto, then Dark, then Light.
  const ORDER = ["auto", "dark", "light"] as const;
  type Mode = (typeof ORDER)[number];
  const LABEL: Record<Mode, string> = { auto: "Auto", dark: "Dark", light: "Light" };
  const button = document.getElementById("theme-toggle");
  const label = document.getElementById("theme-label");
  const read = (): Mode => {
    try {
      const saved = localStorage.getItem("ft-theme");
      return saved === "dark" || saved === "light" ? saved : "auto";
    } catch {
      return "auto";
    }
  };
  let mode: Mode = read();
  let fadeTimer: number | undefined;
  const apply = (): void => {
    if (mode === "auto") delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = mode;
    const next = ORDER[(ORDER.indexOf(mode) + 1) % ORDER.length];
    if (label) label.textContent = LABEL[mode];
    button?.setAttribute("aria-label", `Theme: ${LABEL[mode]}. Switch to ${LABEL[next]}`);
  };
  apply();
  button?.addEventListener("click", () => {
    mode = ORDER[(ORDER.indexOf(mode) + 1) % ORDER.length];
    const root = document.documentElement;
    root.classList.add("theme-fade");
    window.clearTimeout(fadeTimer);
    fadeTimer = window.setTimeout(() => root.classList.remove("theme-fade"), 320);
    try {
      if (mode === "auto") localStorage.removeItem("ft-theme");
      else localStorage.setItem("ft-theme", mode);
    } catch {}
    apply();
  });
</script>
