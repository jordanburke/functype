---
import DocLayout from '../layouts/DocLayout.astro';
import { Content as IOContent } from '../content/io.md';

const links = [
  {
    "href": "/api-docs/interfaces/IO.html",
    "label": "API reference"
  },
  {
    "href": "https://github.com/jordanburke/functype/blob/main/packages/functype/src/io",
    "label": "Source on GitHub"
  }
];
---

<DocLayout
  title="IO for TypeScript: lazy effects with typed errors | functype"
  heading="IO<R,E,A>"
  tagline="IO<R, E, A> is a lazy effect that needs services R, can fail with E and returns A. It runs only when run, with retry, timeout, race and dependency injection."
  links={links}
>
  <IOContent />
</DocLayout>
