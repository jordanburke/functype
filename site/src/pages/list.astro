---
import DocLayout from '../layouts/DocLayout.astro';
import { Content as ListContent } from '../content/list.md';

const links = [
  {
    "href": "/api-docs/interfaces/List.html",
    "label": "API reference"
  },
  {
    "href": "https://github.com/jordanburke/functype/blob/main/packages/functype/src/list",
    "label": "Source on GitHub"
  }
];
---

<DocLayout
  title="List for TypeScript: immutable arrays | functype"
  heading="List<A>"
  tagline="List<A> is an immutable list for TypeScript with map, filter, flatMap and fold. Every operation returns a new List and leaves the original unchanged."
  links={links}
>
  <ListContent />
</DocLayout>
