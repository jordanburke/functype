---
import DocLayout from '../layouts/DocLayout.astro';
import { Content as ObjContent } from '../content/obj.md';

const links = [
  {
    "href": "/api-docs/interfaces/Obj.html",
    "label": "API reference"
  },
  {
    "href": "https://github.com/jordanburke/functype/blob/main/packages/functype/src/obj",
    "label": "Source on GitHub"
  }
];
---

<DocLayout
  title="Obj for TypeScript: immutable objects | functype"
  heading="Obj<T>"
  tagline="Obj<T> wraps a plain object with chainable, immutable operations, so building and updating objects needs no mutation like headers[key] = value."
  links={links}
>
  <ObjContent />
</DocLayout>
