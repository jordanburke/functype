---
import DocLayout from '../layouts/DocLayout.astro';
import { Content as OptionContent } from '../content/option.md';

const links = [
  {
    "href": "/api-docs/types/Option.html",
    "label": "API reference"
  },
  {
    "href": "https://github.com/jordanburke/functype/blob/main/packages/functype/src/option",
    "label": "Source on GitHub"
  }
];
---

<DocLayout
  title="Option for TypeScript: null-safe values | functype"
  heading="Option<T>"
  tagline="Option<T> holds a value (Some) or nothing (None), so null and undefined become a type the compiler checks. Map, chain and unwrap without null checks."
  links={links}
>
  <OptionContent />
</DocLayout>
