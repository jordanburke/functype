---
import DocLayout from '../layouts/DocLayout.astro';
import { Content as OptionContent } from '../content/option.md';

const links = [
  {
    "href": "/api-docs/types/Option.html",
    "label": "API reference"
  },
  {
    "href": "https://github.com/jordanburke/functype/blob/main/packages/functype/src/option",
    "label": "Source on GitHub"
  }
];
---

<DocLayout
  title="Option<T> | functype"
  heading="Option<T>"
  tagline="Safe handling of nullable values"
  links={links}
>
  <OptionContent />
</DocLayout>
