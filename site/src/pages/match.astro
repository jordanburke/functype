---
import DocLayout from '../layouts/DocLayout.astro';
import { Content as MatchContent } from '../content/match.md';

const links = [
  {
    "href": "/api-docs/types/Match.html",
    "label": "API reference"
  },
  {
    "href": "https://github.com/jordanburke/functype/blob/main/packages/functype/src/conditional",
    "label": "Source on GitHub"
