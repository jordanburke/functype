---
import DocLayout from '../layouts/DocLayout.astro';
// Rendered straight from the package README so the rules, severities and options have one source.
import { Content as EslintContent } from '../../../packages/eslint-plugin-functype/README.md';

const links = [
  {
    "href": "https://www.npmjs.com/package/eslint-plugin-functype",
    "label": "npm package"
  },
  {
    "href": "https://github.com/jordanburke/functype/tree/main/packages/eslint-plugin-functype",
    "label": "Source on GitHub"
  }
];
---

<DocLayout
  title="ESLint plugin for functional TypeScript | functype"
  heading="ESLint Plugin"
  tagline="eslint-plugin-functype flags null checks, throws, loops and mutation, and names the functype fix. One preset, every rule an error, built for coding agents."
  links={links}
>
  <EslintContent />
</DocLayout>
