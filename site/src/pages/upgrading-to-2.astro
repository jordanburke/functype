---
import DocLayout from '../layouts/DocLayout.astro';
import { Content as UpgradingContent } from '../content/upgrading-to-2.md';

const links = [
  {
    "href": "https://github.com/jordanburke/functype/blob/main/packages/functype/CHANGELOG.md",
    "label": "Full changelog"
  },
  {
    "href": "https://github.com/jordanburke/functype/issues/277",
    "label": "2.0 tracking issue"
  }
];
---

<DocLayout
  title="Upgrading to functype 2.0"
  heading="Upgrading to 2.0"
  tagline="How to move a codebase from functype 1.x to 2.0: what the compiler finds for you, what it can't see, and what to change in each package."
  links={links}
>
  <UpgradingContent />
</DocLayout>
