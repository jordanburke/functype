---
import DocLayout from '../layouts/DocLayout.astro';
import { Content as DoNotationContent } from '../content/do-notation.md';

const links = [
  {
    "href": "/api-docs/functions/Do.html",
    "label": "API reference"
  },
  {
    "href": "https://github.com/jordanburke/functype/blob/main/packages/functype/src/do",
    "label": "Source on GitHub"
  }
];
---

<DocLayout
  title="Do-notation for TypeScript with generators | functype"
  heading="Do-Notation"
  tagline="Write chains of Option, Either, Try and IO as straight-line code with generators, like Scala's for-comprehensions, instead of nested flatMap calls."
  links={links}
>
  <DoNotationContent />
</DocLayout>
