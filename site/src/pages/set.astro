---
import DocLayout from '../layouts/DocLayout.astro';
import { Content as SetContent } from '../content/set.md';

const links = [
  {
    "href": "/api-docs/interfaces/Set.html",
    "label": "API reference"
  },
  {
    "href": "https://github.com/jordanburke/functype/blob/main/packages/functype/src/set",
    "label": "Source on GitHub"
  }
