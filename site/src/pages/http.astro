---
import DocLayout from '../layouts/DocLayout.astro';
import { Content as HttpContent } from '../content/http.md';

const links = [
  {
    "href": "/api-docs/variables/Http.html",
    "label": "API reference"
  },
  {
    "href": "https://github.com/jordanburke/functype/blob/main/packages/functype/src/fetch",
    "label": "Source on GitHub"
  }
];
---

<DocLayout
  title="Http | functype"
  heading="Http"
  tagline="Typed HTTP fetch wrapper with IO integration"
  links={links}
>
  <HttpContent />
</DocLayout>
