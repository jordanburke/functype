---
import DocLayout from '../layouts/DocLayout.astro';
import { Content as HttpContent } from '../content/http.md';

const links = [
  {
    "href": "/api-docs/variables/Http.html",
    "label": "API reference"
  },
  {
    "href": "https://github.com/jordanburke/functype/blob/main/packages/functype/src/fetch",
    "label": "Source on GitHub"
  }
];
---

<DocLayout
  title="Typed fetch for TypeScript: Http | functype"
  heading="Http"
  tagline="Http wraps fetch so each request is a lazy IO effect with a typed HttpError. Pass a decoder from Zod, TypeBox or Valibot to get typed response bodies."
  links={links}
>
  <HttpContent />
</DocLayout>
