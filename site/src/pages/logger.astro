---
import DocLayout from '../layouts/DocLayout.astro';
import { Content as LoggerContent } from '../content/logger.md';

const links = [
  {
    "href": "/api-docs/interfaces/Logger.html",
    "label": "API reference"
  },
  {
    "href": "https://github.com/jordanburke/functype/blob/main/packages/functype/src/logger",
    "label": "Source on GitHub"
  }
];
---

<DocLayout
  title="Logger: one logging interface for every package | functype"
  heading="Logger"
  tagline="A type-only logging interface with zero runtime. Every functype package logs through it, so one adapter for your own logger plugs in everywhere."
  links={links}
>
  <LoggerContent />
</DocLayout>
