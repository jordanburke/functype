---
import Layout from "../layouts/Layout.astro";

// The hero's Option chain: each line, its inferred type, and its value for each PORT.
const lines = [
  { code: [["kw", "const "], ["id", "port"], ["pun", " = "], ["fn", "Option"], ["pun", "("], ["id", "env.PORT"], ["pun", ")"]], type: "Option<string>" },
  { code: [["pun", "  ."], ["fn", "map"], ["pun", "("], ["id", "Number"], ["pun", ")"]], type: "Option<number>" },
  { code: [["pun", "  ."], ["fn", "filter"], ["pun", "((n) => n > "], ["num", "0"], ["pun", ")"]], type: "Option<number>" },
  { code: [["pun", "  ."], ["fn", "getOrElse"], ["pun", "(() => "], ["num", "3000"], ["pun", ")"]], type: "number" },
] as const;
const runs = {
  ok: { vals: [['Some("8080")', "v"], ["Some(8080)", "v"], ["Some(8080)", "v"], ["8080", "plain"]], caption: '<strong>PORT="8080"</strong> stays a value the whole way down.' },
  zero: { vals: [['Some("0")', "v"], ["Some(0)", "v"], ["None", "none"], ["3000", "plain"]], caption: '<strong>PORT="0"</strong> fails the filter, so getOrElse supplies 3000.' },
  unset: { vals: [["None", "none"], ["None", "none"], ["None", "none"], ["3000", "plain"]], caption: "<strong>PORT unset</strong> is None from the start. map and filter never run." },
} as const;
const valueClass = (kind: string): string => (kind === "v" ? "v" : kind === "none" ? "v none" : "v plain");
---

<Layout title="functype: Option, Either, Try and IO for TypeScript">
  <main>
    <section class="hero wrap">
      <a class="tag" href="/upgrading-to-2/"><b>2.0</b> is out. See what changed</a>
      <h1>Put what can go wrong in the type.</h1>
      <p class="lede">
        Option, Either, Try, List and IO for TypeScript. Missing values, errors and effects become types your compiler
        checks, and so does the agent writing your code.
      </p>
      <div class="actions">
        <a class="btn btn-solid" href="/option/">Read the docs</a>
        <button class="btn btn-ghost install" type="button" id="copy">npm i functype <span class="copy" aria-live="polite">Copy</span></button>
      </div>

      <div class="shot">
        <figure class="editor" aria-label="An Option chain with its types and values shown inline">
          <div class="bar">
            <div class="dots" aria-hidden="true"><span></span><span></span><span></span></div>
            <span class="file">config.ts</span>
            <div class="inputs" role="group" aria-label="Value of PORT">
              <button type="button" data-in="ok" aria-pressed="true">PORT="8080"</button>
              <button type="button" data-in="zero" aria-pressed="false">PORT="0"</button>
              <button type="button" data-in="unset" aria-pressed="false">unset</button>
            </div>
          </div>
          <div class="body">
            <div class="code intro" id="code">
              {
                lines.map((l, i) => (
                  <div class="line">
                    <span class="ln">{i + 1}</span>
                    <span>
                      {l.code.map(([k, t]) => (
                        <span class={k}>{t}</span>
                      ))}
                    </span>
                    <span class="hint" style={`--i:${i}`}>
                      <span class="t">{l.type}</span>
                      <span class={valueClass(runs.ok.vals[i][1])} data-v>
                        {runs.ok.vals[i][0]}
                      </span>
                    </span>
                  </div>
                ))
              }
            </div>
            <figcaption class="result">
              <span class="label"><code>port</code> is a plain number</span>
              <span class="big" id="big">8080</span>
              <span class="why" id="caption" aria-live="polite" set:html={runs.ok.caption} />
            </figcaption>
          </div>
        </figure>
      </div>
    </section>

    <section class="section wrap" id="types">
      <div class="head">
        <h2>Four types for the four ways code goes wrong.</h2>
        <p>Each has a shape for the value and a shape for what happened instead. You handle the problem once, where it makes sense.</p>
      </div>
      <div class="grid">
        <a class="panel span-3" href="/option/"
          ><div class="t-name">Option<span>&lt;A&gt;</span></div><p class="t-say">The value may not be there.</p><div class="shapes"><span class="pill val">Some(a)</span><span class="pill gone">None</span></div></a
        >
        <a class="panel span-3" href="/either/"
          ><div class="t-name">Either<span>&lt;E, A&gt;</span></div><p class="t-say">It failed, and E says how.</p><div class="shapes"><span class="pill val">Right(a)</span><span class="pill err">Left(e)</span></div></a
        >
        <a class="panel span-2" href="/try/"
          ><div class="t-name">Try<span>&lt;A&gt;</span></div><p class="t-say">The code it ran may throw.</p><div class="shapes"><span class="pill val">Success(a)</span><span class="pill err">Failure(e)</span></div></a
        >
        <a class="panel span-4" href="/io/"
          ><div class="t-name">IO<span>&lt;R, E, A&gt;</span></div><p class="t-say">An effect. It needs services R, can fail with E, and runs only when you run it.</p><div class="shapes"><span class="pill val">A</span><span class="pill err">E</span><span class="pill gone">Die</span><span class="pill gone">Interrupted</span></div></a
        >
        <div class="panel span-6 feature">
          <div class="lazy">
            <div>
              <h3>Building an IO runs nothing.</h3>
              <p>
                <code>greet(id)</code> returns a plan. Build it as often as you like and the lookup count stays at zero. It runs
                when you run it.
              </p>
              <div class="counters">
                <div class="counter"><b id="built">0</b><span>programs built</span></div>
                <div class="counter hot"><b id="calls">0</b><span>lookups run</span></div>
              </div>
              <div class="row">
                <button class="btn btn-dark" type="button" id="build42">Build greet("42")</button>
                <button class="btn btn-dark" type="button" id="build7">Build greet("7")</button>
                <button class="btn btn-light" type="button" id="run">Run</button>
              </div>
              <div class="out" id="out" aria-live="polite">Nothing built yet.</div>
            </div>
            <pre data-language="ts"><span class="k">import</span> {"{"} IO, Option, Tag {"}"} <span class="k">from</span> <span class="s">"functype"</span>

<span class="k">type</span> User = {"{"} readonly id: string; readonly name: string {"}"}
<span class="k">class</span> NotFound {"{"} readonly _tag = <span class="s">"NotFound"</span> {"}"}
<span class="k">const</span> Users = Tag&lt;{"{"}
  readonly find: (id: string) =&gt; User | undefined
{"}"}&gt;(<span class="s">"Users"</span>)

<span class="k">const</span> greet = (id: string) =&gt;
  IO.<span class="f">service</span>(Users)
    .<span class="f">flatMap</span>((users) =&gt;
      IO.<span class="f">fromOptionOrFail</span>(Option(users.find(id)), () =&gt; <span class="k">new</span> NotFound()))
    .<span class="f">map</span>((u) =&gt; <span class="s">`Hello, {"${u.name}"}`</span>)
    .<span class="f">catchTag</span>(<span class="s">"NotFound"</span>, () =&gt; IO.<span class="f">succeed</span>(<span class="s">"Hello, guest"</span>))</pre>
          </div>
        </div>
      </div>
    </section>

    <section class="section wrap">
      <div class="head">
        <h2>Small and fast, measured.</h2>
        <p>Against Effect 4.1.5 on Node 24, using the published packages.</p>
      </div>
      <div class="grid">
        <div class="panel span-2 stat">
          <div class="k">Option-only app, gzipped</div>
          <div class="n">5.7<small>KB</small></div>
          <div class="vs">
            <div class="track us"><span>functype</span><i style="width:81%"></i><span>5.7 KB</span></div>
            <div class="track"><span>Effect</span><i style="width:100%"></i><span>7.0 KB</span></div>
          </div>
        </div>
        <div class="panel span-2 stat">
          <div class="k">App with IO, Either, Option, List</div>
          <div class="n">11.5<small>KB</small></div>
          <div class="vs">
            <div class="track us"><span>functype</span><i style="width:31%"></i><span>11.5 KB</span></div>
            <div class="track"><span>Effect</span><i style="width:100%"></i><span>37.3 KB</span></div>
          </div>
        </div>
        <div class="panel span-2 stat">
          <div class="k">Build, map and run an effect</div>
          <div class="n">32<small>ns</small></div>
          <div class="vs">
            <div class="track us"><span>functype</span><i style="width:18%"></i><span>32 ns</span></div>
            <div class="track"><span>Effect</span><i style="width:100%"></i><span>182 ns</span></div>
          </div>
        </div>
      </div>
      <p class="foot-note">A million chained steps run without a stack overflow, and there are no runtime dependencies.</p>
    </section>

    <section class="section wrap" id="agents">
      <div class="head">
        <h2>Your coding agent reads the same docs.</h2>
        <p>It can search them, check its own code against the compiler and the linter, and load everything as plain text.</p>
      </div>
      <div class="grid">
        <a class="panel span-3 agent" href="/mcp-server/"
          ><h3>MCP server</h3><p>validate_code type-checks and lints a snippet before you see it.</p><code class="cmd">npx -y functype-mcp-server</code></a
        >
        <div class="panel span-3 agent">
          <h3>Claude Code plugin</h3><p>The skills and the MCP server in one install.</p><code class="cmd">/plugin marketplace add jordanburke/functype</code><code class="cmd">/plugin install functype</code>
        </div>
        <a class="panel span-3 agent" href="/eslint/"
          ><h3>ESLint plugin</h3><p>One preset, and every message names the fix.</p><code class="cmd">npm i -D eslint-plugin-functype</code></a
        >
        <a class="panel span-3 agent" href="/llms-full.txt"
          ><h3>Docs as text</h3><p>The whole library, for any model that can fetch a URL.</p><code class="cmd">functype.org/llms-full.txt</code></a
        >
      </div>
    </section>
  </main>
</Layout>

<script type="application/json" id="runs" set:html={JSON.stringify(runs)} />

<script>
  type Run = { readonly vals: readonly (readonly [string, string])[]; readonly caption: string };
  const runs = JSON.parse(document.getElementById("runs")?.textContent ?? "{}") as Record<string, Run>;
  const code = document.getElementById("code") as HTMLElement;
  // Restart a short CSS animation on an element, optionally after a delay.
  const flash = (el: HTMLElement, cls: string, delay = 0): void => {
    el.classList.remove(cls);
    el.style.animationDelay = `${delay}ms`;
    void el.offsetWidth;
    el.classList.add(cls);
  };
  const render = (key: string): void => {
    const run = runs[key];
    code.querySelectorAll<HTMLElement>("[data-v]").forEach((el, i) => {
      const [v, kind] = run.vals[i] ?? ["", "v"];
      const cls = kind === "v" ? "v" : kind === "none" ? "v none" : "v plain";
      if (el.textContent === v && el.className.replace(/\s*swap$/, "") === cls) return;
      el.textContent = v;
      el.className = cls;
      flash(el, "swap", i * 40);
    });
    (document.getElementById("caption") as HTMLElement).innerHTML = run.caption;
    const big = document.getElementById("big") as HTMLElement;
    const next = run.vals[run.vals.length - 1]?.[0] ?? "";
    if (big.textContent !== next) {
      big.textContent = next;
      flash(big, "swap", 120);
    }
  };
  document.querySelectorAll(".inputs button").forEach((b) =>
    b.addEventListener("click", () => {
      document.querySelectorAll(".inputs button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      code.classList.remove("intro");
      render((b as HTMLElement).dataset.in ?? "ok");
    }),
  );

  let built = 0;
  let calls = 0;
  let pending: string | null = null;
  const set = (id: string, v: string | number): void => {
    const el = document.getElementById(id);
    if (el) el.textContent = String(v);
  };
  const build = (id: string): void => {
    built += 1;
    pending = id;
    set("built", built);
    set("out", `greet("${id}") is built. Nothing has run.`);
  };
  document.getElementById("build42")?.addEventListener("click", () => build("42"));
  document.getElementById("build7")?.addEventListener("click", () => build("7"));
  document.getElementById("run")?.addEventListener("click", () => {
    if (!pending) {
      set("out", "Build a program first.");
      return;
    }
    calls += 1;
    set("calls", calls);
    const counter = document.getElementById("calls");
    if (counter) flash(counter, "bump");
    set("out", pending === "42" ? 'Result: "Hello, Ada"' : 'Result: "Hello, guest". NotFound was caught by its tag.');
  });
  document.getElementById("copy")?.addEventListener("click", (e) => {
    navigator.clipboard?.writeText("npm i functype").catch(() => {});
    const label = (e.currentTarget as HTMLElement).querySelector(".copy");
    if (label) label.textContent = "Copied";
  });
</script>

