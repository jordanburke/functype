---
import DocLayout from '../layouts/DocLayout.astro';
import { Content as TryContent } from '../content/try.md';

const links = [
  {
    "href": "/api-docs/types/Try.html",
    "label": "API reference"
  },
  {
    "href": "https://github.com/jordanburke/functype/blob/main/packages/functype/src/try",
    "label": "Source on GitHub"
  }
];
---

<DocLayout
  title="Try for TypeScript: exceptions as values | functype"
  heading="Try<T>"
