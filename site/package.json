{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "prebuild": "cp src/content/*.md public/ && pnpm generate:llms",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "validate": "pnpm format && pnpm check && pnpm build && pnpm check:examples",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "check:examples": "tsx scripts/check-examples.ts",
    "copy:md": "cp src/content/*.md public/",
    "generate:llms": "tsx scripts/generate-llms.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.6",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
